# ============================================================
# SocialScraper — Environment Template (copy as .env)
# Each USER creates their own .env — never share or copy someone else's .env
# ============================================================

# Server port (default 3000; use 3010 if another app occupies 3000)
PORT=3010

# Data directory — sessions/queue/stage/temp files are saved here
# (Render/VPS pe persistent disk ka path do, e.g. /data)
# DATA_DIR=

# --- Supabase Auth + Credits (REQUIRED for login) ---
# 1) app.supabase.com → New Project (free)
# 2) Project Settings → API: copy the URL + anon public key + service_role secret
# 3) SQL Editor me "supabase/migrations/001_init.sql" chalao (profiles + 1000 credits trigger)
# Server-side (secrets — kabhi client me mat dalna):
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# For the frontend build (the anon key is public, safe):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- For deployment (Vercel/VPS) ---
# API base from the frontend — same-origin works in production.
# If you have a separate backend (VPS), put its https URL here for the build:
# VITE_API_BASE=https://api.yourdomain.com

# --- Facebook posting (IG/FB reels, queue, scheduling) alag app mein hai ---
# posting-app/ dekho — wahan SUPABASE_URL/ANON/SERVICE_ROLE chahiye (supabase/migrations/003_posting.sql run karo)
