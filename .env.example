# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# AI CAPTION GENERATION (for auto-publisher)
# ==========================================
# AI_SERVICE: Which AI provider to use first for generating captions/hashtags
# Options: gemini | grok | ollama
AI_SERVICE="gemini"

# GEMINI_MODEL: Gemini model to use (default gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# GROK_API_KEY: xAI API key (fallback provider, uses grok-2-1212)
GROK_API_KEY="MY_GROK_API_KEY"

# OLLAMA_BASE_URL: Local Ollama server URL for open-source models
# e.g. http://localhost:11434
OLLAMA_BASE_URL="http://localhost:11434"

# OLLAMA_MODEL: Ollama model name (supports large open-source models)
# e.g. gpt-oss:120b, llama3.3:70b, qwen3:32b
OLLAMA_MODEL="gpt-oss:120b"
